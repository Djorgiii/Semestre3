<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="metodo" type="metodoType">
		<xs:annotation>
			<xs:documentation>
				Elemento raíz que representa pedidos envidados para
				o servidor
				que correspondem à chamada de métodos de interação com o jogo.
			</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:complexType name="metodoType">
		<xs:annotation>
			<xs:documentation>Tipo complexo que define os métodos disponíveis
				para o protocolo de descoberta.
			</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element type="descobrirType" name="descobrir">
				<xs:annotation>
					<xs:documentation>Metodo para usado na mensagem de descoberta.
					</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:complexType name="descobrirType">
		<xs:attribute type="xs:boolean" name="wait"
			use="optional">
			<xs:annotation>
				<xs:documentation>Indica se o servidor tem um 2º jogador à espera.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
</xs:schema>





