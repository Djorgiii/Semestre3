<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <icon>
        <small-icon>/favicon.ico</small-icon>
    </icon>

    <display-name>Pontos e Caixas (JSP)</display-name>
    <description>
        Jogo Pontos e Caixas com suporte a múltiplos modos de operação:
            stand-alone (consola),
            client-server (multi-jogador via TCP)
            e client-Web (interface JSP sobre Tomcat).
        A comunicação entre cliente e servidor ocorre por mensagens XML
        validadas através de XSD, transmitidas sobre TCP.
    </description>

    <!-- Configuração do servidor TCP de jogo -->
    <!-- Alterar servidorHost para o IP da máquina onde corre o Servidor.java -->
    <context-param>
        <param-name>servidorHost</param-name>
        <param-value>localhost</param-value>
    </context-param>

    <context-param>
        <param-name>servidorPorto</param-name>
        <param-value>25565</param-value>
    </context-param>
	
    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <!-- Captura erros de servidor (500) ou excepções não tratadas -->
        <!-- <exception-type>java.lang.Throwable</exception-type> -->
        <location>/WEB-INF/erro.jsp</location>
    </error-page>

    <session-config>
        <session-timeout>60</session-timeout>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>