<?xml version="1.0" encoding="UTF-8"?>
<!--
    resultados.xsd — Schema XML do ficheiro de resultados dos jogos.

    Valida o ficheiro resultados.xml que guarda o histórico de todas as partidas.
    Cada <jogo> regista os dois jogadores, o vencedor, a duração e a data/hora.

    Valores do campo <vencedor>:
      X  — venceu o jogador X
      O  — venceu o jogador O
      EM — empate
      TO — timeout (jogador não jogou nos 30 segundos)
      AB — abandono (um dos jogadores saiu)
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="resultados" type="resultadosType"/>

    <xs:complexType name="resultadosType">
        <xs:sequence>
            <xs:element name="jogo" type="jogoType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
    </xs:complexType>

    <xs:complexType name="jogoType">
        <xs:sequence>
            <xs:element name="jogadorX" type="xs:string"/>
            <xs:element name="jogadorO" type="xs:string"/>
            <xs:element name="vencedor" type="vencedorType"/>
            <xs:element name="duracaoSegundos" type="xs:nonNegativeInteger"/>
            <xs:element name="data"     type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>

    <!-- Vencedor pode ser X, O ou EM (empate) -->
    <xs:simpleType name="vencedorType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="X"/>
            <xs:enumeration value="O"/>
            <xs:enumeration value="EM"/>
            <xs:enumeration value="TO"/> <!-- timeout: jogador não jogou a tempo -->
            <xs:enumeration value="AB"/> <!-- abandono: jogador saiu da partida -->
        </xs:restriction>
    </xs:simpleType>

</xs:schema>
